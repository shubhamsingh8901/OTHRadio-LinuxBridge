<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>OTHRadio</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net6.0</TargetFramework>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>
    <!-- Folder that contains MelonLoader/ (the game install). Override like:
         dotnet build -c Release -p:GameDir="/path/to/Over the Hill"        -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Over the Hill</GameDir>
    <!-- The two halves can also be given independently, e.g. when compiling on a
         machine without the game: -p:RefsDir=".../MelonLoader/net6" -p:ProxiesDir=".../Il2CppAssemblies" -->
    <RefsDir Condition="'$(RefsDir)' == ''">$(GameDir)\MelonLoader\net6</RefsDir>
    <ProxiesDir Condition="'$(ProxiesDir)' == ''">$(GameDir)\MelonLoader\Il2CppAssemblies</ProxiesDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(RefsDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(RefsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(RefsDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ProxiesDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(ProxiesDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFMOD">
      <HintPath>$(ProxiesDir)\Il2CppFMOD.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFMODUnity">
      <HintPath>$(ProxiesDir)\Il2CppFMODUnity.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFunselektor.FunCore.Runtime">
      <HintPath>$(ProxiesDir)\Il2CppFunselektor.FunCore.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ProxiesDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ProxiesDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ProxiesDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ProxiesDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ProxiesDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
